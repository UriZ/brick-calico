<title>Brick Calico</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Nunito+Sans:wght@400;600;700;800&display=swap">
<style>
:root {
  --paper: #F7F5F0;
  --ink: #26303A;
  --ink-soft: #5D6873;
  --card: #FFFFFF;
  --panel: #E7EEF6;
  --line: #DBD6CB;
  --red: #D6291E;
  --red-ink: #FFFFFF;
  --blue: #2E6FD8;
  --yellow: #F2C41D;
  --chip: #EFECE4;
  --scrub: #DDD8CD;
}
:root:not([data-theme="light"]) { }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --paper: #14181E;
    --ink: #E9E7E0;
    --ink-soft: #9AA4AF;
    --card: #1D232C;
    --panel: #101519;
    --line: #303843;
    --red: #E8564A;
    --red-ink: #16181B;
    --blue: #6FA7F0;
    --yellow: #E8BC2B;
    --chip: #232A33;
    --scrub: #2C343E;
  }
}
:root[data-theme="dark"] {
  --paper: #14181E;
  --ink: #E9E7E0;
  --ink-soft: #9AA4AF;
  --card: #1D232C;
  --panel: #101519;
  --line: #303843;
  --red: #E8564A;
  --red-ink: #16181B;
  --blue: #6FA7F0;
  --yellow: #E8BC2B;
  --chip: #232A33;
  --scrub: #2C343E;
}
* { box-sizing: border-box; }
body {
  background: var(--paper);
  color: var(--ink);
  font-family: "Nunito Sans", "Segoe UI", system-ui, sans-serif;
  font-size: 16px;
  line-height: 1.55;
  margin: 0;
}
.wrap { max-width: 1060px; margin: 0 auto; padding: 28px 20px 60px; }

/* ---------- header ---------- */
header { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
.badge {
  width: 76px; height: 76px; flex: none;
  background: var(--red); border-radius: 14px;
  display: grid; place-items: center;
  box-shadow: inset 0 -4px 0 rgba(0,0,0,.18);
}
.badge svg { display: block; }
.masthead { flex: 1 1 260px; }
.eyebrow {
  font-weight: 800; font-size: 12px; letter-spacing: .14em;
  text-transform: uppercase; color: var(--ink-soft);
}
h1 {
  font-family: "Baloo 2", "Nunito Sans", sans-serif;
  font-weight: 800; font-size: clamp(34px, 6vw, 50px);
  line-height: 1; margin: 2px 0 4px; text-wrap: balance;
}
.sub { color: var(--ink-soft); margin: 0; font-size: 17px; }
.facts { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 22px; }
.fact {
  background: var(--chip); border-radius: 999px; padding: 6px 14px;
  font-weight: 700; font-size: 13.5px;
  font-variant-numeric: tabular-nums;
}
.fact b { color: var(--red); }

/* ---------- tabs ---------- */
.tabs {
  display: flex; gap: 4px; margin: 26px 0 18px;
  background: var(--chip); border-radius: 12px; padding: 4px; width: max-content;
  max-width: 100%;
}
.tabs button {
  font-family: "Baloo 2", sans-serif; font-weight: 700; font-size: 16px;
  color: var(--ink-soft); background: none; border: 0; border-radius: 9px;
  padding: 8px 20px; cursor: pointer;
}
.tabs button[aria-selected="true"] { background: var(--red); color: var(--red-ink); }
.tabs button:focus-visible, .stepbtn:focus-visible, .seg:focus-visible {
  outline: 3px solid var(--blue); outline-offset: 2px;
}
section[hidden] { display: none; }

/* ---------- model view ---------- */
.stage {
  position: relative;
  border: 2px solid var(--blue); border-radius: 12px;
  background: var(--panel); overflow: hidden;
}
.stage canvas { display: block; width: 100%; height: min(68vh, 620px); touch-action: none; cursor: grab; }
.stage canvas:active { cursor: grabbing; }
.hint {
  position: absolute; left: 12px; bottom: 10px;
  font-size: 12.5px; font-weight: 700; color: var(--ink-soft);
  background: color-mix(in srgb, var(--card) 82%, transparent);
  padding: 4px 10px; border-radius: 999px; pointer-events: none;
}
.legend { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 14px; font-size: 13.5px; font-weight: 700; color: var(--ink-soft); }
.legend span { display: inline-flex; align-items: center; gap: 7px; font-variant-numeric: tabular-nums; }
.dot { width: 15px; height: 15px; border-radius: 4px; border: 1px solid rgba(0,0,0,.25); display: inline-block; }

/* ---------- instructions ---------- */
.build { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 18px; align-items: start; }
@media (max-width: 780px) { .build { grid-template-columns: 1fr; } }
.build .stage canvas { height: min(62vh, 560px); }
.stepnum-row { display: flex; align-items: baseline; gap: 12px; }
.stepnum {
  font-family: "Baloo 2", sans-serif; font-weight: 800;
  font-size: 76px; line-height: .9; color: var(--red);
  font-variant-numeric: tabular-nums;
}
.stepof { color: var(--ink-soft); font-weight: 700; }
.callout {
  border: 2px dashed color-mix(in srgb, var(--ink) 38%, transparent);
  border-radius: 10px; background: var(--card);
  padding: 14px 16px; margin-top: 14px;
}
.callout h3 {
  margin: 0 0 10px; font-size: 12px; letter-spacing: .13em;
  text-transform: uppercase; color: var(--ink-soft);
}
.parts-mini { display: flex; flex-wrap: wrap; gap: 12px 18px; }
.pm { display: flex; align-items: center; gap: 8px; }
.pm canvas { display: block; }
.pm .ct { font-family: "Baloo 2", sans-serif; font-weight: 800; font-size: 20px; font-variant-numeric: tabular-nums; }
.pm .sz { font-size: 12px; font-weight: 700; color: var(--ink-soft); }
.stepnav { display: flex; gap: 10px; margin-top: 16px; }
.stepbtn {
  flex: 1; font-family: "Baloo 2", sans-serif; font-weight: 700; font-size: 17px;
  border-radius: 10px; padding: 11px 0; cursor: pointer; border: 2px solid var(--red);
}
.stepbtn.next { background: var(--red); color: var(--red-ink); }
.stepbtn.prev { background: none; color: var(--red); }
.stepbtn:disabled { opacity: .35; cursor: default; }
.scrub { width: 100%; margin-top: 14px; accent-color: var(--yellow); cursor: pointer; }
.layerline { font-size: 13px; font-weight: 800; color: var(--ink-soft); letter-spacing: .06em; text-transform: uppercase; margin-top: 2px; }
.stephint { font-size: 12.5px; color: var(--ink-soft); font-weight: 600; margin-top: 10px; }
.newpiece { display: inline-block; width: 12px; height: 12px; border: 2.5px solid var(--yellow); border-radius: 3px; vertical-align: -1px; }

/* ---------- parts inventory ---------- */
.pgroup { margin-top: 26px; }
.pgroup h2 {
  font-family: "Baloo 2", sans-serif; font-weight: 700; font-size: 21px; margin: 0 0 4px;
  display: flex; align-items: center; gap: 10px;
}
.pgroup .gsub { color: var(--ink-soft); font-size: 13.5px; font-weight: 700; margin: 0 0 12px; font-variant-numeric: tabular-nums; }
.pgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
.pcard {
  background: var(--card); border: 1px solid var(--line); border-radius: 10px;
  padding: 12px 12px 10px; display: flex; flex-direction: column; align-items: center; gap: 4px;
}
.pcard canvas { display: block; }
.pcard .ct { font-family: "Baloo 2", sans-serif; font-weight: 800; font-size: 22px; font-variant-numeric: tabular-nums; }
.pcard .nm { font-size: 12.5px; font-weight: 700; color: var(--ink-soft); }

footer {
  margin-top: 44px; padding-top: 16px; border-top: 1px solid var(--line);
  color: var(--ink-soft); font-size: 13px; max-width: 65ch;
}
@media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto; } }
</style>

<div class="wrap">
  <header>
    <div class="badge" aria-hidden="true">
      <svg width="44" height="36" viewBox="0 0 44 36">
        <rect x="2" y="12" width="40" height="21" rx="3" fill="#fff"/>
        <rect x="6" y="6" width="9" height="8" rx="2" fill="#fff"/>
        <rect x="17.5" y="6" width="9" height="8" rx="2" fill="#fff"/>
        <rect x="29" y="6" width="9" height="8" rx="2" fill="#fff"/>
      </svg>
    </div>
    <div class="masthead">
      <div class="eyebrow">Building instructions · Set Nº 560</div>
      <h1>Brick Calico</h1>
      <p class="sub">A life-size calico house cat, built from standard bricks.</p>
    </div>
  </header>

  <div class="facts" id="facts"></div>

  <div class="tabs" role="tablist" aria-label="Views">
    <button role="tab" id="tab-model" aria-selected="true">Model</button>
    <button role="tab" id="tab-build" aria-selected="false">Instructions</button>
    <button role="tab" id="tab-parts" aria-selected="false">Parts</button>
  </div>

  <section id="view-model" aria-labelledby="tab-model">
    <div class="stage">
      <canvas id="cv-model"></canvas>
      <div class="hint">drag to orbit · scroll to zoom</div>
    </div>
    <div class="legend" id="legend"></div>
  </section>

  <section id="view-build" aria-labelledby="tab-build" hidden>
    <div class="build">
      <div class="stage">
        <canvas id="cv-build"></canvas>
        <div class="hint">drag to peek around</div>
      </div>
      <div>
        <div class="stepnum-row">
          <div class="stepnum" id="stepnum">1</div>
          <div class="stepof" id="stepof"></div>
        </div>
        <div class="layerline" id="layerline"></div>
        <div class="callout">
          <h3>Parts for this step</h3>
          <div class="parts-mini" id="stepparts"></div>
        </div>
        <div class="stepnav">
          <button class="stepbtn prev" id="btn-prev">◀ Back</button>
          <button class="stepbtn next" id="btn-next">Next ▶</button>
        </div>
        <input type="range" class="scrub" id="scrub" min="1" value="1" step="1" aria-label="Jump to step">
        <p class="stephint">Each step adds a handful of bricks, working front to back, one layer at a time. New pieces are outlined <span class="newpiece"></span> in the picture. Arrow keys work too.</p>
      </div>
    </div>
  </section>

  <section id="view-parts" aria-labelledby="tab-parts" hidden>
    <div id="inventory"></div>
  </section>

  <footer>
    Built at 1:1 scale — one stud is 8&nbsp;mm, so she stands about 25&nbsp;cm tall from the
    ground to her ear tips, the size of a real sitting house cat. Studs-up sculpture using
    only standard 1×1 through 2×6 bricks; the interior is solid, so every brick locks to the
    layer beneath it. Two lime 1×1s for the eyes and one bright-pink 1×2 for the nose.
  </footer>
</div>
